{
    "manifest_version": 3,
    "name": "X-Ray",
    "version": "1.0.0",
    "description": "Research Cockpit for X",
    "permissions": [
        "sidePanel",
        "activeTab",
        "tabs",
        "scripting",
        "storage",
        "downloads"
    ],
    "icons": {
        "16": "app-icon.png",
        "48": "app-icon.png",
        "128": "app-icon.png"
    },
    "action": {
        "default_title": "Open X-Ray",
        "default_icon": {
            "16": "app-icon.png",
            "48": "app-icon.png",
            "128": "app-icon.png"
        }
    },
    "side_panel": {
        "default_path": "index.html"
    },
    "background": {
        "service_worker": "src/background/index.js",
        "type": "module"
    },
    "content_scripts": [
        {
            "matches": [
                "https://x.com/*",
                "https://twitter.com/*"
            ],
            "js": [
                "src/content/index.js"
            ],
            "run_at": "document_idle"
        }
    ]
}